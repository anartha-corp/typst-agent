{
  "required_status_checks": {
    "strict": true,
    "contexts": [
      "Tests",
      "Check clippy, formatting, and crate docs",
      "Check documentation (website and PDF)",
      "Check minimum Rust version",
      "Check fuzzers",
      "Check unsafe code",
      "Policy and agent PR lane",
      "Reference evidence",
      "Integration testit",
      "Rustfmt",
      "Clippy (--all-features)",
      "Clippy (--no-default-features)",
      "Upstream workspace (ubuntu-latest)",
      "Upstream workspace (macos-latest)",
      "Upstream workspace (windows-latest)",
      "Workspace docs",
      "Minimum supported Rust",
      "Fuzz target build",
      "Miri",
      "DCO sign-off",
      "Dependency review",
      "Analyze Rust / Analyze"
    ]
  },
  "required_pull_request_reviews": {
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": true,
    "required_approving_review_count": 1
  },
  "enforce_admins": true,
  "required_conversation_resolution": true,
  "restrictions": null,
  "allow_force_pushes": false,
  "allow_deletions": false
}
