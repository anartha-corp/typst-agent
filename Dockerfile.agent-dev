FROM docker.io/library/rust:1.92.0-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2

WORKDIR /workspace
COPY . .
ARG REVISION
RUN test -n "$REVISION" && \
    git init && \
    git config user.name "Typst Agent Release" && \
    git config user.email "release@users.noreply.github.com" && \
    git add --all && \
    git commit -m "Typst Agent release source snapshot" && \
    git branch -M main && \
    git remote add origin https://github.com/anartha-corp/typst-agent.git && \
    git remote add upstream https://github.com/typst/typst.git && \
    git remote set-url --push upstream https://invalid.example/typst/typst.git && \
    cargo build --locked -p typst-agent-dev

LABEL org.opencontainers.image.title="Typst Agent development image"
LABEL org.opencontainers.image.description="Pinned, model-free Typst Agent control plane"
LABEL org.opencontainers.image.revision=${REVISION}
LABEL org.opencontainers.image.source="https://github.com/anartha-corp/typst-agent"

ENTRYPOINT ["cargo", "agent"]
